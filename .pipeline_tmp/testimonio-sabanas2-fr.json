[
 {
  "start": 0.0,
  "end": 0.9,
  "texto": "Salut, ça va ?"
 },
 {
  "start": 0.9,
  "end": 1.7,
  "texto": "Moi c'est Pablo."
 },
 {
  "start": 1.7,
  "end": 3.3,
  "texto": "Et après plus de 6 mois"
 },
 {
  "start": 3.3,
  "end": 5.8,
  "texto": "à utiliser les draps Grounding Vitality,"
 },
 {
  "start": 5.8,
  "end": 7.4,
  "texto": "je peux dire que ça a eu un impact"
 },
 {
  "start": 7.4,
  "end": 9.9,
  "texto": "vraiment positif sur ma façon de me reposer,"
 },
 {
  "start": 9.9,
  "end": 12.0,
  "texto": "sur la qualité de mon sommeil"
 },
 {
  "start": 12.0,
  "end": 13.7,
  "texto": "et sur l'énergie que j'ai au réveil."
 },
 {
  "start": 13.7,
  "end": 14.4,
  "texto": "C'est vrai que"
 },
 {
  "start": 14.4,
  "end": 16.8,
  "texto": "j'avais toujours eu du mal"
 },
 {
  "start": 16.8,
  "end": 19.6,
  "texto": "à récupérer cette énergie et à bien dormir,"
 },
 {
  "start": 19.6,
  "end": 21.7,
  "texto": "et à dormir plus de, genre, 6"
 },
 {
  "start": 21.7,
  "end": 23.4,
  "texto": "ou 7 heures."
 },
 {
  "start": 23.4,
  "end": 24.9,
  "texto": "Et franchement, avec ces"
 },
 {
  "start": 24.9,
  "end": 25.6,
  "texto": "draps, euh,"
 },
 {
  "start": 25.6,
  "end": 27.0,
  "texto": "j'y arrive enfin,"
 },
 {
  "start": 27.0,
  "end": 28.8,
  "texto": "ça m'aide énormément à me sentir,"
 },
 {
  "start": 28.8,
  "end": 29.7,
  "texto": "eh bien,"
 },
 {
  "start": 29.7,
  "end": 31.3,
  "texto": "avec plus de vitalité et d'énergie"
 },
 {
  "start": 31.3,
  "end": 32.4,
  "texto": "le matin."
 },
 {
  "start": 32.4,
  "end": 34.2,
  "texto": "Et je sens vraiment que mon"
 },
 {
  "start": 34.2,
  "end": 35.0,
  "texto": "corps se repose"
 },
 {
  "start": 35.0,
  "end": 36.6,
  "texto": "beaucoup plus pendant ces heures"
 },
 {
  "start": 36.6,
  "end": 38.0,
  "texto": "où je dors."
 },
 {
  "start": 38.0,
  "end": 39.7,
  "texto": "Du coup, euh, j'encourage"
 },
 {
  "start": 39.7,
  "end": 41.0,
  "texto": "tout le monde"
 },
 {
  "start": 41.0,
  "end": 42.5,
  "texto": "à les essayer,"
 },
 {
  "start": 42.5,
  "end": 44.0,
  "texto": "parce que je trouve ça vraiment"
 },
 {
  "start": 44.0,
  "end": 44.7,
  "texto": "génial."
 }
]