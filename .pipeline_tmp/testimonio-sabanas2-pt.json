[
 {
  "start": 0.0,
  "end": 0.9,
  "texto": "Olá, tudo bem?"
 },
 {
  "start": 0.9,
  "end": 1.7,
  "texto": "Sou o Pablo."
 },
 {
  "start": 1.7,
  "end": 3.3,
  "texto": "E depois de mais de 6 meses"
 },
 {
  "start": 3.3,
  "end": 5.8,
  "texto": "a usar os lençóis da Grounding Vitality"
 },
 {
  "start": 5.8,
