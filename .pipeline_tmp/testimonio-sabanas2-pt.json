 },
 {
  "start": 19.6,
  "end": 21.7,
  "texto": "e dormir mais de, bem, 6"
 },
 {
  "start": 21.7,
  "end": 23.4,
  "texto": "ou 7 horas."
 },
 {
  "start": 23.4,
  "end": 24.9,
  "texto": "e a verdade é que com estes"
 },
 {
  "start": 24.9,
  "end": 25.6,
  "texto": "lençóis, eh,"
 },
 {
  "start": 25.6,
  "end": 27.0,
  "texto": "estou a conseguir,"
 },
 {
  "start": 27.0,
  "end": 28.8,
  "texto": "está-me a ajudar imenso a sentir-me"
 },
 {
  "start": 28.8,
  "end": 29.7,
  "texto": "bem,"
 },
 {
  "start": 29.7,
  "end": 31.3,
  "texto": "com mais vitalidade e mais energia"
 },
 {
  "start": 31.3,
  "end": 32.4,
  "texto": "de manhã."
 },
 {
  "start": 32.4,
  "end": 34.2,
  "texto": "e a verdade é que noto que o meu"
 },
 {
  "start": 34.2,
  "end": 35.0,
  "texto": "corpo descansa"
 },
 {
  "start": 35.0,
  "end": 36.6,
  "texto": "muito mais nessas, nessas horas"
 },
 {
  "start": 36.6,
  "end": 38.0,
  "texto": "em que estou a dormir."
 },
 {
  "start": 38.0,
  "end": 39.7,
  "texto": "Por isso, eh, a verdade é que incentivo"
 },
 {
  "start": 39.7,
  "end": 41.0,
  "texto": "toda"
 },
 {
  "start": 41.0,
  "end": 42.5,
  "texto": "a gente a experimentar,"
 },
 {
  "start": 42.5,
  "end": 44.0,
  "texto": "já que me parece uma, uma"
 },
 {
  "start": 44.0,
  "end": 44.7,
  "texto": "maravilha."
 }
