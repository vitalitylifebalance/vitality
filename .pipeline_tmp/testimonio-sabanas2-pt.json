  "texto": "posso dizer que teve um impacto"
 },
 {
  "start": 7.4,
  "end": 9.9,
  "texto": "enormemente positivo na forma como descanso,"
 },
 {
  "start": 9.9,
  "end": 12.0,
  "texto": "na qualidade do meu sono"
 },
 {
  "start": 12.0,
  "end": 13.7,
  "texto": "e na energia com que me levanto."
 },
 {
  "start": 13.7,
  "end": 14.4,
  "texto": "A verdade"
 },
 {
  "start": 14.4,
  "end": 16.8,
  "texto": "é que sempre me tinha custado"
 },
 {
  "start": 16.8,
  "end": 19.6,
