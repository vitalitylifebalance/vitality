[
 {
  "start": 0.0,
  "end": 0.9,
  "texto": "Hola, ¿qué tal?"
 },
 {
  "start": 0.9,
  "end": 1.7,
  "texto": "Soy Pablo."
 },
 {
  "start": 1.7,
  "end": 3.3,
  "texto": "Y tras más de 6 meses"
 },
 {
  "start": 3.3,
  "end": 5.8,
