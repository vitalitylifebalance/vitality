 },
 {
  "start": 19.6,
  "end": 21.7,
  "texto": "y dormir más de pues 6"
 },
 {
  "start": 21.7,
  "end": 23.4,
  "texto": "o 7 horas."
 },
 {
  "start": 23.4,
  "end": 24.9,
  "texto": "y la verdad que con estas"
 },
 {
  "start": 24.9,
  "end": 25.6,
  "texto": "sábanas eh"
 },
 {
  "start": 25.6,
  "end": 27.0,
  "texto": "lo estoy consiguiendo,"
 },
 {
  "start": 27.0,
  "end": 28.8,
  "texto": "me está ayudando muchísimo a sentirme"
 },
 {
  "start": 28.8,
  "end": 29.7,
  "texto": "pues"
 },
 {
  "start": 29.7,
  "end": 31.3,
  "texto": "con más vitalidad y más energía"
 },
 {
  "start": 31.3,
  "end": 32.4,
  "texto": "por las mañanas."
 },
 {
  "start": 32.4,
