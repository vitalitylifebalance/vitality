  "end": 12.0,
  "texto": "en la calidad de mi sueño"
 },
 {
  "start": 12.0,
  "end": 13.7,
  "texto": "y en la energía con la que me levanto."
 },
 {
  "start": 13.7,
  "end": 14.4,
  "texto": "La verdad"
 },
 {
  "start": 14.4,
  "end": 16.8,
