  "texto": "a todo"
 },
 {
  "start": 41.0,
  "end": 42.5,
  "texto": "el mundo a que lo pruebe,"
 },
 {
  "start": 42.5,
  "end": 44.0,
  "texto": "ya que me parece una una"
 },
 {
  "start": 44.0,
  "end": 44.7,
